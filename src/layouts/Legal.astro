---
import Base from './Base.astro';
import { brand } from '../data/site';
interface Props { title: string }
const { title } = Astro.props;
---

<Base title={`${title} · ${brand.name}`} description={`${title} for agency-of-one.dev`} noindex>
  <main class="legal">
    <a class="back" href="/">← {brand.mark}</a>
    <h1>{title}</h1>
    <div class="body"><slot /></div>
  </main>
</Base>

<style>
  .legal {
    max-width: calc(600px + 48px); margin: 0 auto; display: grid; gap: 24px;
    padding: 72px max(24px, env(safe-area-inset-right)) 72px max(24px, env(safe-area-inset-left));
  }
  .back { font-size: 0.9375rem; color: var(--muted); text-decoration: none; }
  .back:hover { color: var(--accent-text); }
  h1 { font-size: 2rem; font-weight: 500; letter-spacing: -0.03em; }
  .body { display: grid; gap: 16px; color: var(--muted); }
  .body :global(h2) { color: var(--fg); font-size: 1rem; font-weight: 500; margin-top: 16px; }
  .body :global(p) { margin: 0; }
</style>
