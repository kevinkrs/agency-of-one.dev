---
// How the work gets done, drawn as a trace: Kevin decides scope and architecture, reviews what the agents
// built, sends it back once, and ships. The agents only do the typing in between. It draws once,
// left to right, each time the closing screen comes up.
// x and w are positions on the 22..96 time axis; lanes are agents working in parallel.
import { close } from '../data/site';

const T0 = 0.5, SWEEP = 3.6; // seconds: when the sweep starts, and how long it takes
const steps = [
  { name: 'scope', who: 'me', y: 5, bars: [{ x: 22, w: 7 }] },
  { name: 'architecture', who: 'me', y: 9.6, bars: [{ x: 29, w: 9 }] },
  { name: 'build', who: 'agent', y: 16.4, bars: [{ x: 38, w: 22, dy: -2.2 }, { x: 38, w: 17, dy: 0 }, { x: 40, w: 19, dy: 2.2 }] },
  { name: 'test', who: 'agent', y: 23.2, bars: [{ x: 50, w: 12 }] },
  { name: 'review', who: 'me', y: 27.8, bars: [{ x: 62, w: 12 }, { x: 83, w: 6 }] },
  { name: 'rework', who: 'agent', y: 32.4, bars: [{ x: 74, w: 9 }] },
  { name: 'ship', who: 'me', y: 37, bars: [{ x: 89, w: 4 }] },
];
const at = (x: number) => T0 + ((x - 22) / 74) * SWEEP;
---
<figure class="build" data-tone="card">
  <figcaption>
    <strong>{close.build}</strong>
    <span class="key"><i class="me"></i>Kevin</span>
    <span class="key"><i class="agent"></i>agents</span>
  </figcaption>
  <svg viewBox="0 0 100 40.6" role="img" aria-label="One piece of work as a timeline: Kevin decides the scope and sets the architecture, agents build in parallel and test, Kevin reviews and sends back two fixes, agents rework them, Kevin reviews again and ships.">
    <path class="grid" d="M22 2V39.6M40.5 2V39.6M59 2V39.6M77.5 2V39.6M96 2V39.6" />
    {steps.map((s) => (
      <>
        <text x="2" y={s.y + 1}>{s.name}</text>
        {s.bars.map((b) => {
          const h = b.dy === undefined ? 2.6 : 1.5; // parallel lanes are thinner
          return <rect class:list={['bar', s.who]} style={`--t: ${at(b.x).toFixed(2)}s; --dur: ${((b.w / 74) * SWEEP).toFixed(2)}s`} x={b.x} y={s.y + (b.dy ?? 0) - h / 2} width={b.w} height={h} rx="0.6" />;
        })}
      </>
    ))}
    <text class="note" style={`--t: ${at(74).toFixed(2)}s`} x="84.5" y="33.4">2 fixes</text>
    <path class="done" style={`--t: ${at(93).toFixed(2)}s`} d="M93.6 36.9l1.3 1.3 2.3-2.9" />
    <path class="playhead" style={`--t: ${T0}s; --dur: ${SWEEP}s`} d="M22 2V39.6" />
  </svg>
</figure>

<style>
  .build {
    margin: 1.5rem 0 0;
    padding: 0.9rem 1rem 0.75rem;
    /* The same lit dark surface as the plates in the stack. */
    background: linear-gradient(155deg, #2b3350, var(--bg) 50%, #121625);
    border: 1px solid var(--edge);
    border-top-color: #97a3cc;
    border-radius: 10px;
    box-shadow: 0 18px 40px -18px rgb(0 0 0 / 0.7);
    color: var(--fg);
  }
  figcaption { display: flex; flex-wrap: wrap; align-items: baseline; gap: 0.2rem 0.9rem; font-size: 0.8125rem; color: var(--muted); }
  /* The heading takes its own line on phones, so the key never wraps halfway. */
  strong { flex: 1 0 100%; font-size: 0.9375rem; font-weight: 500; color: var(--fg); }
  @media (min-width: 900px) { strong { flex: 1 0 auto; } }
  /* Phones keep the line and drop the drawing, so the stack stays in view above the sheet. */
  @media (max-width: 899px) { .build svg, .build .key { display: none; } .build { padding-bottom: 0.9rem; } }
  .key { display: inline-flex; align-items: center; gap: 0.4rem; }
  .key i { width: 0.7rem; height: 0.35rem; border-radius: 2px; }
  .me { background: var(--fg); fill: var(--fg); }
  .agent { background: var(--ai); fill: var(--ai); }

  svg { display: block; width: 100%; margin-top: 0.5rem; }
  text { fill: var(--muted); font-size: 3px; letter-spacing: 0.02em; }
  .note { fill: var(--warn); animation: build-show 0.3s linear var(--t) both; }
  .grid { stroke: var(--faint); stroke-width: 0.14; }
  .bar { transform-box: fill-box; transform-origin: left center; animation: build-grow var(--dur) linear var(--t) both; }
  .done { fill: none; stroke: var(--ok); stroke-width: 0.7; stroke-linecap: round; stroke-linejoin: round; animation: build-show 0.3s linear var(--t) both; }
  .playhead { stroke: var(--accent); stroke-width: 0.3; animation: build-sweep var(--dur) linear var(--t) both; }

  /* In the flight the trace waits until the closing screen is up, so it draws on arrival. */
  :global(.js-flight .panel:not(.is-active)) .build * { animation: none; }
  @media (prefers-reduced-motion: reduce) { .build * { animation: none; } .playhead { display: none; } }

  @keyframes build-grow { from { transform: scaleX(0); } }
  @keyframes build-show { from { opacity: 0; } }
  @keyframes build-sweep { from { transform: translateX(0); opacity: 1; } 96% { opacity: 1; } to { transform: translateX(74px); opacity: 0; } }
</style>
