---
// Auth plate. One login per 8s cycle: failed tries fill the attempts counter, the password is
// typed, submit sends it to the verifier (salted hash compared with the stored hash), a TOTP code
// confirms, a session token is issued with an expiry bar that drains and is refreshed, then a
// request carrying the editor role passes the gate to /posts and is stopped at /billing.
// Timings (--t) are seconds into the cycle. Every window ends before 8s.
import Marker from './Marker.astro';

const dots = [0, 1, 2, 3, 4, 5];
const roles = [{ x: 6, name: 'admin' }, { x: 18, name: 'editor' }, { x: 30, name: 'viewer' }];
---
<!-- sign-in form -->
<rect x="6" y="6" width="28" height="26" rx="1.5" />
<rect x="9" y="10" width="22" height="5" rx="1" />
<rect class="soft" x="10.5" y="11.7" width="10" height="1.6" />
<rect x="9" y="18" width="22" height="5" rx="1" />
{dots.map((i) => <path class="dot" style={`--t: ${0.5 + i * 0.15}s`} d={`M${12 + i * 2.8} 20.5h0`} />)}
<rect class="flash" style="--t: 1.5s" x="9" y="26" width="22" height="4" rx="1" />
<rect class="soft" x="16" y="27.5" width="8" height="1" />

<!-- verifier and user store -->
<path d="M34 19H42M52 30V34H20V38M62 21H72.5" />
<rect x="42" y="8" width="20" height="22" rx="1.5" />
<text class="tag" x="45" y="12.5">bcrypt</text>
<rect class="soft hashflash" style="--t: 2.2s" x="45" y="15.5" width="14" height="2" />
<rect class="soft" x="45" y="20" width="14" height="2" />
<path class="pop ok" style="--t: 2.8s" d="M48.5 26.5l1.6 1.6 3-3.6" />
<rect x="70" y="8" width="24" height="22" rx="1.5" />
<text class="tag" x="72.5" y="12.5">users</text>
{[14.5, 19.5, 24.5].map((y, i) => (
  <>
    <rect class:list={[i === 1 && 'lookup']} style="--t: 2.4s" x="72.5" y={y} width="19" height="4" rx="0.8" />
    <rect class:list={['soft', i === 1 && 'lookupfill']} style="--t: 2.4s" x="74" y={y + 1.3} width="10" height="1.4" />
  </>
))}

<!-- second factor -->
<rect x="6" y="38" width="28" height="16" rx="1.5" />
<text class="tag" x="8.5" y="42.2">TOTP</text>
{dots.map((i) => (
  <>
    <rect x={8.5 + i * 3.9} y="45" width="3" height="5.5" rx="0.6" />
    <rect class="digit" style={`--t: ${4 + i * 0.12}s`} x={9.4 + i * 3.9} y="46.4" width="1.2" height="2.7" />
  </>
))}

<!-- session token -->
<path d="M34 47H44" />
<rect class="flash" style="--t: 5s" x="44" y="41" width="30" height="11" rx="1.5" />
<text class="tag" x="46.5" y="46">exp 15 min</text>
<rect class="soft" x="46.5" y="48.2" width="25" height="1.6" />
<rect class="fill bar" style="--t: 5s" x="46.5" y="48.2" width="25" height="1.6" />

<!-- attempts counter -->
<rect x="77" y="41" width="18" height="11" rx="1.5" />
<text class="tag" x="79" y="46">lock at 5</text>
{[0, 1, 2, 3, 4].map((i) => <rect class:list={['solid', i < 3 && 'fail']} style={`--t: ${0.2 + i * 0.25}s`} x={78.8 + i * 3.3} y="48.2" width="2.2" height="2.2" rx="0.4" />)}

<!-- roles and gate -->
<path d="M50 52V58H23V63M23 68.5V88M23 76H56.5M59.5 76H68M23 88H56.5M59.5 88H68" />
{roles.map((r) => (
  <>
    <rect class:list={[r.name === 'editor' && 'flash']} style="--t: 6.1s" x={r.x} y="63" width="10" height="5.5" rx="1" />
    <text class="tag" x={r.x + 5} y="66.6" text-anchor="middle">{r.name}</text>
  </>
))}
<path class="node gate" style="--t: 6.5s" d="M58 72V80" />
<path class="node nudge" style="--t: 7.05s" d="M58 84V92" />
<rect class="flashok" style="--t: 6.7s" x="68" y="71" width="26" height="10" rx="1.5" />
<text class="tag" x="71" y="76.8">/posts</text>
<rect x="68" y="83" width="26" height="10" rx="1.5" />
<text class="tag" x="71" y="88.8">/billing</text>
<text class="tag err pop" style="--t: 6.85s" x="91" y="88.8" text-anchor="end">403</text>

<!-- packets: password, hash query, session confirm, code, token, then the request twice -->
<circle class="packet hop" r="1.1" style="--t: 1.6s; offset-path: path('M34 19H46')" />
<circle class="packet hop" r="1.1" style="--t: 2.1s; offset-path: path('M62 21H72.5')" />
<circle class="packet hopl" r="1.1" style="--t: 3s; offset-path: path('M52 30V34H20V38')" />
<circle class="packet hop" r="1.1" style="--t: 4.7s; offset-path: path('M34 47H48')" />
<circle class="packet hopl" r="1.1" style="--t: 5.2s; offset-path: path('M50 52V58H23V63')" />
<circle class="packet hopl" r="1.1" style="--t: 6.2s; offset-path: path('M23 68.5V76H68')" />
<circle class="packet bounce" r="1.1" style="--t: 6.2s; offset-path: path('M23 68.5V88H56.4')" />

<Marker n={1} x={44} y={41} /><Marker n={2} x={43} y={63.5} /><Marker n={3} x={94} y={41} />

<style>
  .dot { stroke: var(--faint); stroke-width: 1.1; }
  .digit { fill: var(--faint); stroke: none; }
  .bar { transform-box: fill-box; transform-origin: 0 50%; }
  .pop { --o: 0; }

  .hop, .hopl, .bounce { --o: 0; }
  .hop { animation: signin-hop 8s linear var(--t) infinite; }
  .hopl { animation: signin-hopl 8s linear var(--t) infinite; }
  .bounce { animation: signin-reject 8s linear var(--t) infinite; }
  .flash { animation: signin-flash 8s linear var(--t) infinite; }
  .flashok { animation: signin-flashok 8s linear var(--t) infinite; }
  .lookup { animation: signin-lookup 8s linear var(--t) infinite; }
  .lookupfill { animation: signin-lookupfill 8s linear var(--t) infinite; }
  .hashflash { animation: signin-hashflash 8s linear var(--t) infinite; }
  .dot { animation: signin-dot 8s linear var(--t) infinite; }
  .digit { animation: signin-digit 8s linear var(--t) infinite; }
  .fail { animation: signin-fail 8s linear var(--t) infinite; }
  .pop { animation: signin-pop 8s linear var(--t) infinite; }
  .bar { animation: signin-bar 8s linear var(--t) infinite; }
  .gate { animation: signin-gate 8s linear var(--t) infinite; }
  .nudge { animation: signin-nudge 8s linear var(--t) infinite; }

  @keyframes signin-hop {
    0% { offset-distance: 0%; --o: 0; }
    1% { --o: 1; }
    6% { offset-distance: 100%; --o: 1; }
    7%, 100% { offset-distance: 100%; --o: 0; }
  }
  @keyframes signin-hopl {
    0% { offset-distance: 0%; --o: 0; }
    1% { --o: 1; }
    12% { offset-distance: 100%; --o: 1; }
    13%, 100% { offset-distance: 100%; --o: 0; }
  }
  /* The blocked request runs to the gate, is pushed back twice, and fades. */
  @keyframes signin-reject {
    0% { offset-distance: 0%; --o: 0; fill: var(--accent); }
    1% { --o: 1; }
    12% { offset-distance: 100%; --o: 1; fill: var(--accent); }
    12.5% { fill: var(--err); }
    15% { offset-distance: 90%; --o: 1; }
    17.5% { offset-distance: 100%; --o: 1; }
    20%, 100% { offset-distance: 94%; --o: 0; }
  }
  @keyframes signin-flash { 0%, 16%, 100% { stroke: var(--fg); } 2%, 9% { stroke: var(--accent); } }
  @keyframes signin-flashok { 0%, 16%, 100% { stroke: var(--fg); } 2%, 9% { stroke: var(--ok); } }
  /* The user-store lookup is data being read: info. */
  @keyframes signin-lookup { 0%, 16%, 100% { stroke: var(--fg); } 2%, 9% { stroke: var(--info); } }
  @keyframes signin-lookupfill { 0%, 16%, 100% { fill: var(--faint); } 2%, 9% { fill: var(--info); } }
  @keyframes signin-hashflash { 0%, 16%, 100% { fill: var(--faint); } 2%, 9% { fill: var(--accent); } }
  /* Typing and code entry: an empty slot fills in, stays, then clears. */
  @keyframes signin-dot { 0%, 40%, 100% { stroke: var(--faint); } 2% { stroke: var(--accent); } 6%, 34% { stroke: var(--fg); } }
  @keyframes signin-digit { 0%, 40%, 100% { fill: var(--faint); } 2% { fill: var(--accent); } 6%, 34% { fill: var(--ok); } }
  /* A failed attempt fills a cell. A successful sign-in clears them. */
  @keyframes signin-fail {
    0%, 38%, 100% { fill: var(--bg); }
    1.5% { fill: var(--warn); }
    6%, 34% { fill: var(--warn); }
  }
  @keyframes signin-pop { 0%, 13%, 100% { --o: 0; } 2%, 9% { --o: 1; } }
  /* Expiry bar: full on issue, drains, refreshed before it runs out, full again at the seam. */
  @keyframes signin-bar {
    0%, 6% { --tf: scaleX(1); fill: var(--accent); }
    10% { --tf: scaleX(1); fill: var(--fg); }
    22% { --tf: scaleX(0.567); fill: var(--fg); }
    28% { --tf: scaleX(0.35); fill: var(--warn); }
    31% { --tf: scaleX(1); fill: var(--accent); }
    36%, 100% { --tf: scaleX(1); fill: var(--fg); }
  }
  /* Gate lifts for an allowed role and drops again. */
  @keyframes signin-gate { 0%, 14%, 100% { --tf: translateY(0); stroke: var(--fg); } 3%, 10% { --tf: translateY(-7px); stroke: var(--ok); } }
  @keyframes signin-nudge { 0%, 10%, 100% { --tf: translateX(0); stroke: var(--fg); } 3% { --tf: translateX(-0.8px); stroke: var(--err); } 6% { --tf: translateX(0.3px); stroke: var(--err); } }
</style>
