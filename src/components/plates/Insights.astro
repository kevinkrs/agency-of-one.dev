---
// Insights plate: what the running product tells you. One 7s cycle: events arrive in the stream
// and move the funnel, then one request is traced across the layers as a span waterfall.
// Timings (--t) are seconds into the cycle.
import Marker from './Marker.astro';

const events = [
  { name: '$pageview /orders', at: '12:04:01', tone: 'lit-fill', t: 0.4 },
  { name: 'click refresh', at: '12:04:03', tone: 'lit-fill', t: 1.2 },
  { name: 'sign_in', at: '12:04:09', tone: 'ok-fill', t: 2.0 },
  { name: 'order_created', at: '12:04:31', tone: 'ok-fill', t: 2.8 },
  { name: '$exception 503', at: '12:05:12', tone: 'err-fill', t: 6.2 },
];
const funnel = [
  { name: 'visit', share: '100%', w: 36, t: 0.4 },
  { name: 'sign in', share: '64%', w: 23, t: 2.0 },
  { name: 'order', share: '31%', w: 11, t: 2.8 },
];
// The trace: x and w are positions on the 28..90 time axis (412 ms across).
const T0 = 3.3, SWEEP = 2.0;
const spans = [
  { name: 'interface', x: 28, w: 62, tone: 'lit-fill' },
  { name: 'sign-in', x: 30, w: 6, tone: 'lit-fill' },
  { name: 'server', x: 36, w: 52, tone: 'lit-fill' },
  { name: 'model', x: 44, w: 38, tone: 'ai-fill', note: '280 ms' },
  { name: 'database', x: 83, w: 4, tone: 'info-fill' },
];
const start = (x: number) => (T0 + ((x - 28) / 62) * SWEEP).toFixed(2);
---
<!-- event stream -->
<rect x="6" y="6" width="42" height="42" rx="1.5" />
<text class="tag" x="9" y="11.5">events</text>
{events.map((e, i) => {
  const y = 18 + i * 6.4;
  return (
    <>
      <circle class="ping" style={`--t: ${e.t}s`} cx="10.5" cy={y - 0.8} r="1" />
      <circle class={e.tone} cx="10.5" cy={y - 0.8} r="1" />
      <text class="tag name" style={`--t: ${e.t}s`} x="13.5" y={y}>{e.name}</text>
      <text class="tag" x="45" y={y} text-anchor="end">{e.at}</text>
    </>
  );
})}

<!-- funnel -->
<rect x="52" y="6" width="42" height="42" rx="1.5" />
<text class="tag" x="55" y="11.5">funnel</text>
{funnel.map((f, i) => {
  const y = 17 + i * 10.4;
  return (
    <>
      <text class="tag" x="55" y={y}>{f.name}</text>
      <text class="tag" x="91" y={y} text-anchor="end">{f.share}</text>
      <rect class="track" x="55" y={y + 1.6} width="36" height="4" rx="0.8" />
      <rect class="lit-fill step" style={`--t: ${f.t}s`} x="55" y={y + 1.6} width={f.w} height="4" rx="0.8" />
    </>
  );
})}

<!-- trace waterfall -->
<rect x="6" y="54" width="88" height="40" rx="1.5" />
<text class="tag" x="9" y="59.5">trace 4f2a91</text>
<text class="tag" x="91" y="59.5" text-anchor="end">412 ms</text>
<path class="hair" d="M28 62.5V91M43.5 62.5V91M59 62.5V91M74.5 62.5V91M90 62.5V91" />
{spans.map((s, i) => {
  const y = 66.5 + i * 5.4;
  return (
    <>
      <text class="tag" x="9" y={y + 0.9}>{s.name}</text>
      <rect class:list={[s.tone, 'span']} style={`--t: ${start(s.x)}s`} x={s.x} y={y - 1.6} width={s.w} height="3.2" rx="0.8" />
      {s.note && <text class="tag warn" x={s.x + s.w - 1} y={y - 2.4} text-anchor="end">{s.note}</text>}
    </>
  );
})}
<path class="lit playhead" d="M28 62.5V91" />

<Marker n={1} x={48} y={6} /><Marker n={2} x={94} y={6} /><Marker n={3} x={94} y={54} />

<style>
  .track { fill: var(--faint); stroke: none; fill-opacity: 0.35; }
  .ping { fill: none; stroke: var(--fg); stroke-width: 0.25; transform-box: fill-box; transform-origin: center; --o: 0; animation: insights-ping 7s linear var(--t) infinite; }
  .name { animation: insights-name 7s linear var(--t) infinite; }
  .step { animation: insights-step 7s linear var(--t) infinite; }
  .span { transform-box: fill-box; transform-origin: left center; animation: insights-span 7s linear var(--t) infinite; }
  .playhead { --o: 0; animation: insights-playhead 7s linear infinite; }

  @keyframes insights-ping { 0% { --o: 0.9; --tf: scale(1); } 9% { --o: 0; --tf: scale(3.4); } 100% { --o: 0; --tf: scale(3.4); } }
  @keyframes insights-name { 0%, 14%, 100% { fill: var(--muted); } 1%, 8% { fill: var(--fg); } }
  @keyframes insights-step { 0%, 12%, 100% { fill-opacity: 1; } 1%, 6% { fill-opacity: 0.45; } }
  /* Before its start time a span shows complete; at its start it is redrawn from the left. */
  @keyframes insights-span { 0% { --tf: scaleX(0); } 11% { --tf: scaleX(1); } 100% { --tf: scaleX(1); } }
  @keyframes insights-playhead {
    0%, 46% { --o: 0; --tf: translateX(0px); }
    47% { --o: 1; --tf: translateX(0px); }
    76% { --o: 1; --tf: translateX(62px); }
    78%, 100% { --o: 0; --tf: translateX(62px); }
  }
</style>
