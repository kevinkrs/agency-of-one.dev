---
// A numbered point on a plate. `n` matches the layer's `points` in src/data/site.ts (1..3).
interface Props { n: number; x: number; y: number }
const { n, x, y } = Astro.props;
---
<g class="marker" style={`--n: ${n}`}>
  <circle cx={x} cy={y} r="2.7" />
  <text x={x} y={y + 1.15} text-anchor="middle">{n}</text>
</g>
