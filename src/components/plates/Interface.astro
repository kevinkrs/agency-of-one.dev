---
// Interface plate. One cycle (24s) is three runs of the same interaction, 8s each: press Refresh,
// the request leaves the screen, a skeleton shows while it is out, the response comes back.
// Run 1 succeeds and rows fill in one by one, then Tab steps through the controls. Run 2 returns
// an empty list. Run 3 returns a 503 on the last row and the pointer presses Retry.
// The phone frame is the same screen in one column and follows the same states.
// Keyframes are generated from times in seconds so every window reads as a time, not a percentage.
import Marker from './Marker.astro';

const C = 24;
const pct = (t: number) => +((t / C) * 100).toFixed(3);
type Ev = [number, string];
const kf = (n: string, e: Ev[]) => `@keyframes interface-${n}{${e.map(([t, d]) => `${pct(t)}%{${d}}`).join('')}}`;
// opacity-style windows: `on` between a and b (with a short fade), `off` elsewhere
const win = (wins: [number, number][], on: string, off: string, f = 0.15): Ev[] => {
  const e: Ev[] = [[0, off]];
  for (const [a, b] of wins) e.push([a, off], [a + f, on], [b, on], [b + f, off]);
  e.push([C, off]);
  return e;
};
const show = (wins: [number, number][]) => win(wins, '--o:1', '--o:0');
const hide = (wins: [number, number][]) => win(wins, '--o:0', '--o:1');
const RUNS = [0, 8, 16];
const press = RUNS.map((r): [number, number] => [r + 1.25, r + 1.8]);
const loading = RUNS.map((r): [number, number] => [r + 1.5, r + 4]);

// pointer: relative to its rest spot (16,50); button tip (55,54.75); retry tip (55,45.1)
const P = (x: number, y: number) => `--tf:translate(${x}px,${y}px);animation-timing-function:cubic-bezier(.16,1,.3,1)`;
const rest = P(0, 0), btn = P(39, 4.75), retry = P(39, -4.9);
const ptr: Ev[] = [[0, rest]];
for (const r of [0, 8]) ptr.push([r + 0.4, rest], [r + 1.25, btn], [r + 3.2, btn], [r + 4, rest]);
ptr.push([16.4, rest], [17.25, btn], [22, btn], [22.55, retry], [23.1, retry], [23.7, rest], [C, rest]);

const packet = (segs: [number, number][]): Ev[] => {
  const e: Ev[] = [[0, 'offset-distance:0%;--o:0']];
  for (const [a, b] of segs) e.push([a, 'offset-distance:0%;--o:0'], [a + 0.05, 'offset-distance:0%;--o:1'], [b, 'offset-distance:100%;--o:1'], [b + 0.05, 'offset-distance:100%;--o:0']);
  e.push([C, 'offset-distance:0%;--o:0']);
  return e;
};
const bar = (segs: [number, number, number][]): Ev[] => {
  const e: Ev[] = [[0, '--tf:scaleX(0)']];
  for (const [a, b, c] of segs) e.push([a, '--tf:scaleX(0)'], [b, '--tf:scaleX(1)'], [c, '--tf:scaleX(1)'], [c + 0.2, '--tf:scaleX(0)']);
  e.push([C, '--tf:scaleX(0)']);
  return e;
};

const anims: Record<string, Ev[]> = {
  ptr,
  press: show(press),
  retry: show([[22.55, 23.1]]),
  load: show(loading),
  skel: show([[1.5, 5.3], [9.5, 12], [17.5, 21.3]]),
  peel: hide([[4, 7], [20, 23]]), // per-row --t staggers the reveal; the cover is only up while .skel is
  empty: show([[12, 15.6]]),
  err: show([[20.6, 22.95]]),
  // "ready" is the neutral tag: hidden while loading, empty or failed
  ready: hide([[1.5, 4], [9.5, 15.6], [17.5, 22.95]]),
  loadtag: show(loading),
  zero: show([[12, 15.6]]),
  failed: show([[20.2, 22.95]]),
  s200: hide([[20, 23.4]]),
  s503: show([[20, 23.4]]),
  ring1: show([[5.6, 6.3]]),
  ring2: show([[6.3, 7]]),
  ring3: show([[7, 7.7]]),
  out: packet(RUNS.map((r): [number, number] => [r + 1.5, r + 2.5])),
  back: packet(RUNS.map((r): [number, number] => [r + 3, r + 4])),
  net1: bar(RUNS.map((r): [number, number, number] => [r + 1.5, r + 4, r + 6.5])),
  net2: bar([[22.7, 23.4, 23.7]]),
};

const css =
  Object.entries(anims).map(([n, e]) => kf(n, e)).join('') +
  `@keyframes interface-sweep{0%{stroke-dashoffset:25}100%{stroke-dashoffset:-100}}` +
  Object.keys(anims).map((n) => `.plate .ix-${n}{animation:interface-${n} ${C}s linear var(--t,0s) infinite}`).join('') +
  `.plate .ix-load{animation:interface-load ${C}s linear infinite,interface-sweep 1.2s linear infinite}` +
  `.plate .ix-cover{stroke:none}` +
  `.plate .ix-off,.plate .ix-out,.plate .ix-back{--o:0}` +
  `.plate .ix-bar{--tf:scaleX(0);transform-box:fill-box;transform-origin:0 50%}` +
  `@media (prefers-reduced-motion:reduce){.plate [class*="ix-"]{animation:none!important}}`;

const rows = [{ y: 23.2, n: 18 }, { y: 29.6, n: 14 }, { y: 36, n: 20 }, { y: 42.4, n: 12 }];
const cards = [18.5, 28, 37.5];
---
<!-- desktop window -->
<rect x="6" y="8" width="60" height="50" rx="1.5" />
<path class="hair" d="M6 13H66" />
<text class="tag" x="9" y="11.6">orders</text>
<text class="tag ix-ready" x="63" y="11.6" text-anchor="end">ready</text>
<text class="tag ix-off ix-loadtag" x="63" y="11.6" text-anchor="end">loading</text>
<text class="tag ix-off ix-zero" x="63" y="11.6" text-anchor="end">0 results</text>
<text class="tag ix-off ix-failed" x="63" y="11.6" text-anchor="end">failed</text>
<path class="lit ix-off ix-load" d="M6 13H66" pathLength="100" stroke-dasharray="25 75" style="stroke-width: 0.5" />

<!-- controls -->
<rect x="9" y="15" width="26" height="5.5" rx="1" />
<rect class="soft" x="11" y="17.2" width="10" height="1.1" />
<rect x="38" y="15" width="14" height="5.5" rx="1" />
<rect class="soft" x="40" y="17.2" width="6" height="1.1" />

<!-- rows -->
<rect x="9" y="22.5" width="54" height="27" rx="1.5" />
{rows.map((r, i) => (
  <>
    <rect class="fill" x="11" y={r.y + 2} width="5" height="1" />
    <rect class="fill" x="21" y={r.y + 2} width={r.n} height="1" />
    <rect x="49" y={r.y + 1.1} width="11" height="3.2" rx="1.6" />
    {i < 3 && <path class="hair" d={`M9 ${r.y + 5.9}H63`} />}
  </>
))}

<!-- refresh -->
<rect x="46" y="51" width="14" height="5.5" rx="1" />
<text class="tag" x="53" y="54.5" text-anchor="middle">Refresh</text>
<rect class="lit ix-off ix-press" x="46" y="51" width="14" height="5.5" rx="1" />

<!-- skeleton: covers the rows while the request is out, peeled off row by row -->
<g class="ix-off ix-skel">
  {rows.map((r, i) => (
    <g class="ix-peel" style={`--t: ${(i * 0.28).toFixed(2)}s`}>
      <rect class="solid ix-cover" x="9.4" y={r.y - 0.3} width="53.2" height="5.9" />
      <rect class="soft" x="11" y={r.y + 1.6} width="5" height="1.8" />
      <rect class="soft" x="21" y={r.y + 1.6} width={r.n} height="1.8" />
      <rect class="soft" x="49" y={r.y + 1.1} width="11" height="3.2" rx="1.6" />
    </g>
  ))}
</g>

<!-- empty state -->
<g class="ix-off ix-empty">
  <rect class="solid ix-cover" x="9.4" y="22.9" width="53.2" height="26.2" />
  <circle cx="36" cy="32.5" r="2.6" />
  <path d="M37.9 34.4l2.2 2.2" />
  <text class="tag" x="36" y="42" text-anchor="middle">no orders</text>
</g>

<!-- error row -->
<g class="ix-off ix-err">
  <rect class="solid ix-cover" x="9.4" y="42.1" width="53.2" height="5.9" />
  <path d="M11.5 44.1l2 2M13.5 44.1l-2 2" />
  <text class="tag" x="16" y="45.9">couldn't load</text>
  <rect x="50" y="43.2" width="10" height="3.8" rx="1" />
  <text class="tag" x="55" y="45.8" text-anchor="middle">retry</text>
</g>
<rect class="lit ix-off ix-retry" x="50" y="43.2" width="10" height="3.8" rx="1" />

<!-- keyboard focus: Tab order search, filter, refresh -->
<rect class="lit ix-off ix-ring1" x="8.3" y="14.3" width="27.4" height="6.9" rx="1.4" />
<rect class="lit ix-off ix-ring2" x="37.3" y="14.3" width="15.4" height="6.9" rx="1.4" />
<rect class="lit ix-off ix-ring3" x="45.3" y="50.3" width="15.4" height="6.9" rx="1.4" />

<!-- phone, one column -->
<rect x="72" y="8" width="22" height="50" rx="2" />
<rect class="soft" x="75" y="11.9" width="7" height="1.4" />
<circle cx="90" cy="12.6" r="1" />
{cards.map((y) => (
  <>
    <rect x="75" y={y} width="16" height="8" rx="1" />
    <rect class="fill" x="77" y={y + 2} width="5" height="1" />
    <rect x="84.5" y={y + 1.4} width="5" height="2.4" rx="1.2" />
    <rect class="fill" x="77" y={y + 4.8} width="10" height="1" />
  </>
))}
<rect x="75" y="48" width="16" height="5.5" rx="1" />
<text class="tag" x="83" y="51.6" text-anchor="middle">Refresh</text>
<rect class="lit ix-off ix-press" x="75" y="48" width="16" height="5.5" rx="1" />
<g class="ix-off ix-skel">
  {cards.map((y, i) => (
    <g class="ix-peel" style={`--t: ${(i === 2 ? 0.84 : i * 0.28).toFixed(2)}s`}>
      <rect class="solid ix-cover" x="75.3" y={y + 0.3} width="15.4" height="7.4" />
      <rect class="soft" x="77" y={y + 1.7} width="5" height="1.8" />
      <rect class="soft" x="77" y={y + 4.5} width="10" height="1.8" />
    </g>
  ))}
</g>
<g class="ix-off ix-empty">
  <rect class="solid ix-cover" x="74.6" y="17.8" width="16.8" height="28.6" />
  <circle cx="83" cy="30" r="2" />
  <path d="M84.5 31.5l1.8 1.8" />
</g>
<g class="ix-off ix-err">
  <rect class="solid ix-cover" x="75.3" y="37.8" width="15.4" height="7.4" />
  <path d="M77 40.5l2 2M79 40.5l-2 2" />
  <rect x="81.5" y="40.4" width="7.5" height="3" rx="1" />
</g>
<path class="hair" d="M72 61H94M72 59.5v3M94 59.5v3" />
<text class="tag" x="83" y="65.5" text-anchor="middle">375 px</text>

<!-- the wire to the layers below -->
<path class="dash" d="M52 56.5V100M58 100V56.5" />
<text class="tag" x="50.5" y="95.5" text-anchor="end">request</text>
<text class="tag" x="59.5" y="95.5">response</text>

<!-- network log -->
<rect x="6" y="64" width="38" height="26" rx="1.5" />
<text class="tag" x="9" y="68.6">network</text>
<text class="tag" x="9" y="75">GET /orders</text>
<text class="tag ix-s200" x="41" y="75" text-anchor="end">200</text>
<text class="tag ix-off ix-s503" x="41" y="75" text-anchor="end">503</text>
<rect class="soft" x="9" y="76.6" width="32" height="1.4" />
<rect class="lit-fill ix-bar ix-net1" x="9" y="76.6" width="32" height="1.4" />
<text class="tag" x="9" y="83.5">GET /orders</text>
<text class="tag" x="41" y="83.5" text-anchor="end">200</text>
<rect class="soft" x="9" y="85.1" width="32" height="1.4" />
<rect class="lit-fill ix-bar ix-net2" x="9" y="85.1" width="32" height="1.4" />

<!-- pointer and request packets -->
<g transform="translate(16 50)">
  <path class="fill ix-ptr" style="stroke: var(--bg); stroke-width: 0.3" d="M0 0v4.4l1.2-1.1 1 2.2.9-.4-1-2.1h1.6z" />
</g>
<circle class="packet ix-out" r="1.1" style="offset-path: path('M52 56.5V100')" />
<circle class="packet ix-back" r="1.1" style="offset-path: path('M58 100V56.5')" />

<Marker n={1} x={63} y={22.5} /><Marker n={2} x={93} y={8} /><Marker n={3} x={60.5} y={51} />

<style is:inline set:html={css}></style>
