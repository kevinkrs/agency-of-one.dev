---
import { stages } from '../data/site';
// Caption per stage: 0 is the hero, 1..6 follow src/data/site.ts.
const names = ['an idea', ...stages.map((s) => s.name)];

// Exploded isometric stack. Each plate is a 100x100 square in plan view, projected by `iso(cy)`;
// cy is the screen y of the plate's left and right corners. Lower plates come first in the markup
// so the upper ones cover them.
const CX = 150;
const iso = (cy: number) => `matrix(1 .5 -1 .5 ${CX} ${cy - 50})`;
const side = (cy: number) => `M50 ${cy}L150 ${cy + 50} 250 ${cy}V${cy + 6}L150 ${cy + 56} 50 ${cy + 6}Z`;
const Y = { ui: 80, auth: 150, server: 220, cloud: 290, ml: 360 };
---
<figure class="figure" data-figure data-names={JSON.stringify(names)}>
  <svg viewBox="0 0 360 428" role="img" aria-label="A product assembled as a stack of layers: the interface on top, then sign-in, a server with a database, several machines in the cloud, and machine learning models at the bottom.">
    <!-- 6 ML models -->
    <g class="layer plate" data-from="6">
      <path class="solid" d={side(Y.ml)} />
      <g transform={iso(Y.ml)}>
        <rect class="solid" width="100" height="100" />
        <path d="M22 26 50 36 22 50 50 64 22 74M22 26 50 64M22 74 50 36M22 50 50 36M50 36 78 50 50 64" />
        <path class="node" d="M22 26h0M22 50h0M22 74h0M50 36h0M50 64h0M78 50h0" />
        <rect x="60" y="82" width="8" height="8" /><rect x="72" y="82" width="8" height="8" /><rect x="84" y="82" width="8" height="8" />
      </g>
      <path class="lead" d={`M256 ${Y.ml}H272`} /><text x="278" y={Y.ml + 4}>models</text>
    </g>

    <!-- 5 cloud -->
    <g class="layer plate" data-from="5">
      <path class="solid" d={side(Y.cloud)} />
      <g transform={iso(Y.cloud)}>
        <rect class="solid" width="100" height="100" />
        <rect class="dashed" x="6" y="6" width="88" height="88" />
        <rect x="14" y="14" width="20" height="20" /><rect x="40" y="14" width="20" height="20" /><rect x="66" y="14" width="20" height="20" />
        <path d="M19 21H29M19 27H29M45 21H55M45 27H55M71 21H81M71 27H81" />
        <path d="M24 34V44H76V34M50 34V52" />
        <path d="M14 84 28 72 40 78 54 60 68 68 86 50" />
      </g>
      <path class="lead" d={`M256 ${Y.cloud}H272`} /><text x="278" y={Y.cloud + 4}>cloud</text>
    </g>

    <!-- 3 server + database -->
    <g class="layer plate" data-from="3">
      <path class="solid" d={side(Y.server)} />
      <g transform={iso(Y.server)}>
        <rect class="solid" width="100" height="100" />
        <rect x="10" y="10" width="40" height="11" /><rect x="10" y="26" width="40" height="11" /><rect x="10" y="42" width="40" height="11" />
        <path class="node" d="M44 15.5h0M44 31.5h0M44 47.5h0" />
        <rect class="soft" x="10" y="64" width="40" height="4" /><rect class="soft" x="10" y="74" width="28" height="4" />
      </g>
      <path class="solid" d="M169 222v14a16 6 0 0 0 32 0v-14" />
      <ellipse class="solid" cx="185" cy="222" rx="16" ry="6" />
      <path d="M169 229a16 6 0 0 0 32 0" />
      <path class="lead" d={`M256 ${Y.server}H272`} /><text x="278" y={Y.server + 4}>server</text>
    </g>

    <!-- 4 authentication: slides into the gap between interface and server -->
    <g class="layer plate" data-from="4">
      <path class="solid" d={side(Y.auth)} />
      <g transform={iso(Y.auth)}>
        <rect class="solid" width="100" height="100" />
        <path d="M43 46v-8a7 7 0 0 1 14 0v8" />
        <rect x="38" y="46" width="24" height="20" rx="2" />
        <path d="M50 55V61" /><path class="node" d="M50 54h0" />
        <rect class="soft" x="10" y="10" width="20" height="6" /><rect class="soft" x="10" y="21" width="14" height="6" /><rect class="soft" x="70" y="84" width="20" height="6" />
      </g>
      <path class="lead" d={`M256 ${Y.auth}H272`} /><text x="278" y={Y.auth + 4}>sign-in</text>
    </g>

    <!-- the plate everything starts on -->
    <g class="layer" data-from="0">
      <path class="solid" d={side(Y.ui)} />
      <g transform={iso(Y.ui)}>
        <rect class="solid" width="100" height="100" />
        <g class="layer" data-from="0" data-to="0"><rect class="cursor" x="11" y="10" width="2.5" height="13" /></g>
        <!-- 1 wireframe -->
        <g class="layer sketch" data-from="1" data-to="1">
          <rect x="10" y="10" width="45" height="8" />
          <rect x="10" y="24" width="80" height="38" />
          <path d="M10 24 90 62M10 62 90 24M10 72H55M10 80H45" />
          <rect x="64" y="70" width="26" height="14" />
        </g>
        <!-- 2 frontend -->
        <g class="layer" data-from="2">
          <rect class="fill" x="10" y="10" width="45" height="8" />
          <rect x="10" y="24" width="80" height="38" />
          <path d="M16 56 34 36 46 48 56 40 72 56" />
          <circle cx="78" cy="34" r="4" />
          <rect class="soft" x="10" y="71" width="45" height="4" /><rect class="soft" x="10" y="79" width="35" height="4" />
          <rect class="fill" x="64" y="70" width="26" height="14" />
        </g>
      </g>
      <g class="layer" data-from="1" data-to="1"><path class="lead" d={`M256 ${Y.ui}H272`} /><text x="278" y={Y.ui + 4}>wireframe</text></g>
      <g class="layer" data-from="2"><path class="lead" d={`M256 ${Y.ui}H272`} /><text x="278" y={Y.ui + 4}>frontend</text></g>
    </g>

    <!-- assembly axes at the corners, and the requests travelling along them -->
    <g class="layer" data-from="3">
      <path class="axis" d={`M250 ${Y.ui + 6}V${Y.server}M50 ${Y.ui + 6}V${Y.server}`} />
      <circle class="dot" r="3.5" style={`offset-path: path('M250 ${Y.ui + 6}V${Y.server}'); animation-duration: 1.8s`} />
      <circle class="dot" r="3.5" style={`offset-path: path('M50 ${Y.server}V${Y.ui + 6}'); animation-duration: 2.4s`} />
    </g>
    <g class="layer" data-from="5">
      <path class="axis" d={`M250 ${Y.server + 6}V${Y.cloud}M50 ${Y.server + 6}V${Y.cloud}`} />
      <circle class="dot" r="3.5" style={`offset-path: path('M250 ${Y.server + 6}V${Y.cloud}'); animation-duration: 1.5s`} />
    </g>
    <g class="layer" data-from="6">
      <path class="axis" d={`M250 ${Y.cloud + 6}V${Y.ml}M50 ${Y.cloud + 6}V${Y.ml}`} />
      <circle class="dot" r="3.5" style={`offset-path: path('M50 ${Y.cloud + 6}V${Y.ml}'); animation-duration: 3.6s`} />
    </g>
  </svg>
  <figcaption><span data-fig-n>6</span> / 6 <span data-fig-name>{names[6]}</span></figcaption>
</figure>

<script>
  import '../scripts/figure.ts';
</script>

<style>
  .figure { margin: 0; width: 100%; max-width: 360px; height: 100%; display: flex; flex-direction: column; justify-content: center; }
  svg { display: block; width: 100%; flex: 1 1 auto; min-height: 0; overflow: visible; fill: none; stroke: var(--fg); stroke-width: 1.5; stroke-linecap: round; stroke-linejoin: round; }
  /* Keeps hairlines even inside the skewed plates and when the figure is scaled down. */
  svg :global(*) { vector-effect: non-scaling-stroke; }
  text { fill: var(--muted); stroke: none; font-size: 11px; letter-spacing: 0.01em; }
  /* 14% = the stack's left edge inside the 360-wide viewBox */
  figcaption { margin-top: 10px; padding-left: 14%; font-size: 0.8125rem; color: var(--muted); font-variant-numeric: tabular-nums; }
  figcaption [data-fig-name] { margin-left: 0.6em; color: var(--fg); }

  .solid { fill: var(--bg); }
  .fill { fill: var(--fg); stroke: none; transition: fill 0.8s var(--ease); }
  .soft { fill: var(--faint); stroke: none; }
  .node { stroke-width: 5; }
  .dashed { stroke: var(--faint); stroke-dasharray: 3 4; }
  .sketch { stroke: var(--muted); stroke-dasharray: 3 4; }
  .lead { stroke: var(--faint); }
  .axis { stroke: var(--faint); stroke-dasharray: 2 5; }
  .cursor { fill: var(--accent); stroke: none; animation: blink 1.1s steps(1) infinite; }
  .dot { fill: var(--accent); stroke: none; offset-rotate: 0deg; animation: travel 2s ease-in-out infinite alternate; }

  .layer { transition: opacity 0.5s var(--ease), stroke 0.9s var(--ease); }
  .plate { transition: opacity 0.5s var(--ease), stroke 0.9s var(--ease), transform 0.9s var(--ease); }
  /* Layers hide only once the script runs, so the figure is complete without it. */
  .js .layer:not(.is-on) { opacity: 0; }
  .js .plate:not(.is-on) { transform: translate(34px, -46px); }
  .is-new { stroke: var(--accent); }
  .is-new .fill { fill: var(--accent); }
  .is-new text { fill: var(--accent-text); }

  /* On phones the figure is too small for its labels; the caption names the stage. */
  @media (max-width: 899px) {
    text, .lead { display: none; }
    figcaption { padding-left: 0; text-align: center; }
  }

  @keyframes blink { 50% { opacity: 0; } }
  @keyframes travel { from { offset-distance: 0%; } to { offset-distance: 100%; } }

  @media (prefers-reduced-motion: reduce) {
    .layer, .plate, .fill { transition: none; }
    .cursor { animation: none; }
    .dot { animation: none; offset-distance: 50%; }
  }
</style>
