---
// The five plates of the stack, top to bottom, each drawn in plan view on a 100x100 square.
// The camera (src/scripts/flight.ts) moves the whole stack in 3D. Markers 1..3 on each plate match
// that layer's `points` in src/data/site.ts.
import { layers } from '../data/site';

const marker = (n: number, x: number, y: number) => ({ n, x, y });
const markers = [
  [marker(1, 92, 24), marker(2, 64, 64), marker(3, 36.5, 77.5)],
  [marker(1, 20, 79), marker(2, 80, 8), marker(3, 82, 75)],
  [marker(1, 13, 38), marker(2, 30, 40), marker(3, 91, 74)],
  [marker(1, 11, 42), marker(2, 33, 44), marker(3, 78, 74)],
  [marker(1, 58, 8), marker(2, 50, 61), marker(3, 41, 56)],
];
const machine = (x: number, y: number) => `M${x + 3} ${y + 5}H${x + 9}M${x + 3} ${y + 9}H${x + 9}`;
const zoneA = [[13, 36], [29, 36], [13, 56]];
const zoneB = [[59, 36], [75, 36], [59, 56], [75, 56]];
---
<div class="world" data-world>
  {layers.map((layer, i) => (
    <svg class="plate" data-plate style={`--i: ${i}`} viewBox="0 0 100 100" role="img" aria-label={`${layer.label} layer`}>
      {i === 0 && (
        <>
          <rect x="8" y="8" width="84" height="11" rx="1.5" />
          <rect class="fill" x="11" y="11" width="10" height="5" rx="1" />
          <path d="M62 13.5H68M72 13.5H78M82 13.5H88" />
          <rect x="8" y="24" width="50" height="34" rx="1.5" />
          <path d="M12 54 26 36 36 46 44 40 54 54" />
          <circle cx="48" cy="31" r="3" />
          <rect class="dash" x="64" y="24" width="28" height="34" rx="1.5" />
          <rect class="soft" x="68" y="29" width="20" height="4" /><rect class="soft" x="68" y="37" width="14" height="4" /><rect class="soft" x="68" y="45" width="18" height="4" />
          <rect class="soft" x="8" y="64" width="30" height="3" /><rect class="soft" x="8" y="70" width="22" height="3" />
          <rect class="fill" x="8" y="80" width="26" height="10" rx="1.5" />
          <rect class="dash" x="5.5" y="77.5" width="31" height="15" rx="3" />
          <rect class="dash" x="44" y="64" width="20" height="30" rx="2.5" />
          <rect class="soft" x="48" y="69" width="12" height="3" /><rect class="soft" x="48" y="75" width="8" height="3" />
          <rect class="fill" x="48" y="84" width="12" height="5" rx="1" />
        </>
      )}
      {i === 1 && (
        <>
          <rect x="20" y="8" width="17" height="7" rx="3.5" /><rect x="41" y="8" width="17" height="7" rx="3.5" /><rect class="dash" x="62" y="8" width="18" height="7" rx="3.5" />
          <rect x="20" y="24" width="60" height="12" rx="1.5" /><rect class="soft" x="24" y="28.5" width="26" height="3" />
          <rect x="20" y="41" width="60" height="12" rx="1.5" /><path class="node" d="M26 47h0M32 47h0M38 47h0M44 47h0M50 47h0" />
          <rect class="fill" x="20" y="58" width="60" height="12" rx="1.5" />
          <rect class="soft" x="56" y="74" width="24" height="2.5" />
          <circle cx="27" cy="86" r="6" /><path d="M27 82.5V86L29.5 88" />
          <rect x="37" y="82" width="30" height="8" rx="4" /><rect class="fill" x="37" y="82" width="12" height="8" rx="4" />
        </>
      )}
      {i === 2 && (
        <>
          <path d="M0 50H6M20 50H26M34 50H38M38 21V79M38 21H42M38 50H42M38 79H42" />
          <rect x="6" y="38" width="14" height="24" rx="1.5" /><path d="M10 50l2.5 3 5-6" />
          <path d="M26 42V58M30 44V56M34 46V54" />
          <rect x="42" y="14" width="22" height="14" rx="1.5" /><rect x="42" y="43" width="22" height="14" rx="1.5" /><rect x="42" y="72" width="22" height="14" rx="1.5" />
          <rect class="soft" x="46" y="19.5" width="12" height="3" /><rect class="soft" x="46" y="48.5" width="14" height="3" /><rect class="soft" x="46" y="77.5" width="10" height="3" />
          <path d="M64 21H69V79H64M64 50H73" />
          <ellipse cx="82" cy="45" rx="9" ry="3.5" /><path d="M73 45v10a9 3.5 0 0 0 18 0v-10M73 50a9 3.5 0 0 0 18 0" />
          <g class="dash"><path d="M82 58.5V70.5" /><ellipse cx="82" cy="74" rx="9" ry="3.5" /><path d="M73 74v9a9 3.5 0 0 0 18 0v-9" /></g>
        </>
      )}
      {i === 3 && (
        <>
          <path d="M0 50H6M16 50H22M44 50H50M78 50H84M94 50H100" />
          <path d="M6 42h10v9c0 4-2.5 6.5-5 8-2.5-1.5-5-4-5-8z" /><path d="M84 42h10v9c0 4-2.5 6.5-5 8-2.5-1.5-5-4-5-8z" />
          <rect x="22" y="46" width="6" height="8" rx="1" /><rect x="30" y="46" width="6" height="8" rx="1" /><rect x="38" y="46" width="6" height="8" rx="1" />
          <rect x="50" y="34" width="28" height="32" rx="2" />
          <path d="M55 41 64 45.5 55 50 64 54.5 55 59M55 41 64 54.5M55 59 64 45.5M64 45.5 73 50 64 54.5" />
          <path class="node" d="M55 41h0M55 50h0M55 59h0M64 45.5h0M64 54.5h0M73 50h0" />
          <path class="dash" d="M89 42V22H33V46M64 66V74" />
          <rect x="50" y="74" width="28" height="18" rx="1.5" />
          <path d="M54 79.5l1.5 1.5 2.5-3M54 86.5l1.5 1.5 2.5-3" />
          <rect class="soft" x="61" y="78.5" width="13" height="2.5" /><rect class="soft" x="61" y="85.5" width="10" height="2.5" />
        </>
      )}
      {i === 4 && (
        <>
          <path d="M50 0V8M50 18V24M27 24H73M27 24V30M73 24V30" />
          <rect x="42" y="8" width="16" height="10" rx="5" />
          <rect class="dash" x="8" y="30" width="38" height="62" rx="2" /><rect class="dash" x="54" y="30" width="38" height="62" rx="2" />
          {[...zoneA, ...zoneB].map(([x, y]) => <><rect x={x} y={y} width="12" height="14" rx="1.5" /><path d={machine(x, y)} /></>)}
          <rect class="dash" x="29" y="56" width="12" height="14" rx="1.5" />
          <path d="M12 82h8l2-5 3 9 2-4h14M58 82h8l2-5 3 9 2-4h14" />
        </>
      )}
      {markers[i].map((m) => (
        <g class="marker" style={`--n: ${m.n}`}>
          <circle cx={m.x} cy={m.y} r="2.7" />
          <text x={m.x} y={m.y + 1.15} text-anchor="middle">{m.n}</text>
        </g>
      ))}
    </svg>
  ))}
</div>

<style>
  .world { position: relative; width: var(--p); height: var(--p); transform-style: preserve-3d; --gap: 120; transform: scale(0.5) rotateX(57deg) rotateZ(45deg) translateZ(240px); will-change: transform; }
  .plate {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    background: var(--bg);
    border: 1.5px solid var(--fg);
    border-radius: 6px;
    transform: translateZ(calc(var(--gap) * var(--i) * -1px));
    fill: none;
    stroke: var(--fg);
    stroke-width: 0.3;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .fill { fill: var(--fg); stroke: none; }
  .soft { fill: var(--faint); stroke: none; }
  .node { stroke-width: 1.1; }
  .dash { stroke: var(--muted); stroke-dasharray: 0.9 1; }

  .marker circle { fill: var(--accent); stroke: var(--bg); stroke-width: 0.5; }
  .marker text { fill: #fff; stroke: none; font-size: 3.1px; font-weight: 600; }
  /* Markers only show on the plate the camera is on, one after the other. */
  :global(.js-flight) .marker { opacity: 0; transform: scale(0.4); transform-box: fill-box; transform-origin: center; transition: opacity 0.3s var(--ease), transform 0.5s var(--ease); }
  :global(.js-flight) .is-focus .marker { opacity: 1; transform: none; transition-delay: calc(var(--n) * 140ms + 150ms); }
</style>
