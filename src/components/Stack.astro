---
// The five plates of the stack, top to bottom, in the order of `layers` in src/data/site.ts.
// The camera (src/scripts/flight.ts) moves the whole stack in 3D; `flat` lays the plates out
// side by side instead, for the preview pages under /plates/.
import '../styles/plates.css';
import { layers } from '../data/site';
import Interface from './plates/Interface.astro';
import SignIn from './plates/SignIn.astro';
import Server from './plates/Server.astro';
import Models from './plates/Models.astro';
import Cloud from './plates/Cloud.astro';

interface Props { flat?: boolean; only?: string }
const { flat = false, only } = Astro.props;
const drawings = [Interface, SignIn, Server, Models, Cloud];
---
<div class:list={['world', { flat }]} data-world>
  {layers.map((layer, i) => {
    const Drawing = drawings[i];
    return (!only || only === layer.id) && (
      <svg class:list={['plate', { 'is-focus': flat }]} data-plate style={`--i: ${i}`} viewBox="0 0 100 100" role="img" aria-label={`${layer.label} layer`}>
        <Drawing />
      </svg>
    );
  })}
</div>

<style>
  .world { position: relative; width: var(--p); height: var(--p); transform-style: preserve-3d; --gap: 120; transform: scale(0.5) rotateX(57deg) rotateZ(45deg) translateZ(240px); will-change: transform; }
  .plate {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    background: var(--bg);
    border: 1.5px solid var(--fg);
    border-radius: 6px;
    transform: translateZ(calc(var(--gap) * var(--i) * -1px));
  }
  .world.flat { display: flex; flex-wrap: wrap; gap: 32px; width: auto; height: auto; transform: none; }
  .flat .plate { position: static; width: min(92vw, 720px); height: auto; aspect-ratio: 1; transform: none; }
</style>
