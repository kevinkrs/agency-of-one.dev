---
// The five plates of the stack, top to bottom, in the order of `layers` in src/data/site.ts.
// The camera (src/scripts/flight.ts) moves the whole stack in 3D; `flat` lays the plates out
// side by side instead, for the preview pages under /plates/.
import '../styles/plates.css';
import { layers } from '../data/site';
import Interface from './plates/Interface.astro';
import SignIn from './plates/SignIn.astro';
import Server from './plates/Server.astro';
import Models from './plates/Models.astro';
import Cloud from './plates/Cloud.astro';

interface Props { flat?: boolean; only?: string }
const { flat = false, only } = Astro.props;
const drawings = [Interface, SignIn, Server, Models, Cloud];
---
<div class:list={['world', { flat }]} data-world>
  {layers.map((layer, i) => {
    const Drawing = drawings[i];
    return (!only || only === layer.id) && (
      <svg class:list={['plate', { 'is-focus is-live': flat }]} data-plate data-tone="card" style={`--i: ${i}`} viewBox="0 0 100 100" role="img" aria-label={`${layer.label} layer`}>
        <Drawing />
      </svg>
    );
  })}
  {!flat && layers.slice(1).map((_, i) => <><i class="riser l" style={`--i: ${i}`} /><i class="riser r" style={`--i: ${i}`} /></>)}
  {!flat && Array.from({ length: 8 }, (_, n) => <i class:list={['dot', n % 2 ? 'r' : 'l']} data-dot />)}
</div>

<style>
  .world { position: relative; width: var(--p); height: var(--p); transform-style: preserve-3d; --gap: 120; transform: scale(0.5) rotateX(57deg) rotateZ(45deg) translateZ(240px); }
  .plate {
    position: absolute;
    left: 0;
    top: 0;
    /* Painted at twice its size and scaled back down, so lines and labels stay sharp when the
       camera tilts and zooms. will-change pins that double-size bitmap. */
    width: 200%;
    height: 200%;
    background: linear-gradient(155deg, #181c2a, var(--bg) 55%);
    border: 2px solid var(--edge);
    border-radius: 16px;
    transform-origin: 0 0;
    transform: translateZ(calc(var(--gap) * var(--i) * -1px)) scale(0.5);
    will-change: transform;
  }
  /* Risers join each plate to the next one down, on the left and right edge; dots are the
     requests going down (left) and the answers coming back up (right). flight.ts moves the dots. */
  .riser {
    position: absolute;
    top: 50%;
    width: 3px;
    height: calc(var(--gap) * 1px);
    background: var(--fg);
    opacity: 0.7;
    transform-origin: top;
    transform-style: preserve-3d;
    transform: translateZ(calc(var(--gap) * var(--i) * -1px)) rotateX(-90deg);
  }
  /* A second ribbon at a right angle, so the riser never turns edge-on to the camera. */
  .riser::after { content: ''; position: absolute; inset: 0; background: inherit; transform: rotateY(90deg); }
  .dot { position: absolute; top: 50%; width: 16px; height: 16px; margin: -8px; border-radius: 50%; background: var(--accent); }
  .riser.l, .dot.l { left: -16px; }
  .riser.r, .dot.r { left: calc(100% + 16px); }

  .world.flat { display: flex; flex-wrap: wrap; gap: 32px; width: auto; height: auto; transform: none; }
  .flat .plate { position: static; width: min(92vw, 720px); height: auto; aspect-ratio: 1; transform: none; will-change: auto; border-width: 1px; border-radius: 8px; }
</style>
