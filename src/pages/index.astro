---
import Base from '../layouts/Base.astro';
import Figure from '../components/Figure.astro';
import { brand, hero, stages, close } from '../data/site';

const links = [
  { label: 'Talk to Kevin', href: `mailto:${brand.email}` },
  { label: 'LinkedIn', href: brand.linkedin },
  { label: 'CV', href: brand.cv },
];
const closeLinks = [
  { label: brand.email, href: `mailto:${brand.email}` },
  links[1],
  links[2],
];
---
<Base title="Agency of One: Kevin Kraus, product engineer" description={`${hero.title} ${hero.text}`}>
  <div class="frame" aria-hidden="true"><i /><i /><i /><i /></div>
  <dl class="title-block">
    <div><dt>Title</dt><dd>{brand.name}</dd></div>
    <div><dt>Drawn by</dt><dd>{brand.person}</dd></div>
    <div><dt>Sheet</dt><dd><span data-fig-n>6</span> / 6</dd></div>
    <div><dt>Layer</dt><dd data-fig-name>ML models</dd></div>
  </dl>
  <main class="layout">
    <div class="fig-col">
      <div class="fig"><Figure /></div>
    </div>
    <div class="text">
      <section class="hero" data-stage="0">
        <div class="mark">{brand.mark}</div>
        <h1>{hero.title}</h1>
        <p>{hero.text}</p>
        <div class="links">
          {links.map((l) => <a href={l.href}>{l.label}</a>)}
        </div>
      </section>

      {stages.map((s, i) => (
        <section class="stage" id={s.id} data-stage={i + 1}>
          <h2>{s.title}</h2>
          <p>{s.text}</p>
        </section>
      ))}

      <section class="close" id="contact" data-stage="6">
        <div class="close-body">
          <h2>{close.title}</h2>
          <p>{close.text}</p>
          <div class="links big">
            {closeLinks.map((l) => <a href={l.href}>{l.label}</a>)}
          </div>
        </div>
        <footer>
          <span>Agency of One · Kevin Kraus · Hamburg</span>
          <a href="/impressum/">Impressum</a>
          <a href="/datenschutz/">Datenschutz</a>
        </footer>
      </section>
    </div>
  </main>
</Base>

<style>
  /* The sheet: a fixed drawing border with centre ticks. */
  .frame { position: fixed; inset: 10px; z-index: 5; border: 1.5px solid var(--fg); pointer-events: none; }
  .frame i { position: absolute; background: var(--fg); }
  .frame i:nth-child(1), .frame i:nth-child(2) { top: 50%; width: 12px; height: 1.5px; }
  .frame i:nth-child(1) { left: 0; } .frame i:nth-child(2) { right: 0; }
  .frame i:nth-child(3), .frame i:nth-child(4) { left: 50%; width: 1.5px; height: 12px; }
  .frame i:nth-child(3) { top: 0; } .frame i:nth-child(4) { bottom: 0; }
  .frame i:nth-child(1), .frame i:nth-child(2) { display: none; } /* side ticks would cut through the text on phones */
  .title-block { display: none; }

  /* Mobile first: single column, figure pinned on top. */
  .layout { display: block; padding: 10px; }
  .fig-col { display: contents; }
  .fig {
    position: sticky;
    top: 10px;
    z-index: 2;
    height: 42svh;
    padding: 12px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--bg);
    border-bottom: 1.5px solid var(--fg);
  }

  section {
    display: flex;
    flex-direction: column;
    justify-content: center;
    min-height: 60svh;
    padding: 4rem 20px;
  }
  section > :global(*), .close-body > :global(*) { max-width: 400px; }
  p { color: var(--muted); }
  h1 { font-size: 2.5rem; line-height: 1.1; letter-spacing: -0.025em; }
  h2 { font-size: 1.75rem; line-height: 1.15; }
  h1 + p, h2 + p { margin-top: 1rem; }

  .mark { font-size: 1.5rem; font-weight: 700; line-height: 1; margin-bottom: 3.5rem; }
  .links { display: flex; flex-wrap: wrap; gap: 0.75rem 1.75rem; margin-top: 2.5rem; font-size: 1.25rem; font-weight: 500; }
  .links a { text-decoration-thickness: 2px; }
  .links.big { font-size: 1.5rem; }

  .close { min-height: 80svh; }
  .close-body { margin-block: auto; padding-block: 4rem; }
  .close h2 { font-size: 2.5rem; line-height: 1.1; }
  footer { display: flex; flex-wrap: wrap; gap: 0.25rem 1.25rem; max-width: none; font-size: 0.8125rem; color: var(--muted); }

  @media (min-width: 900px) {
    .frame { inset: 28px; }
    .frame i:nth-child(1), .frame i:nth-child(2) { display: block; }
    .layout {
      display: grid;
      grid-template-columns: minmax(320px, 400px) minmax(0, 1fr);
      column-gap: 48px;
      max-width: 1320px;
      margin-inline: auto;
      padding: 0 84px;
    }
    .fig-col { display: block; grid-column: 2; grid-row: 1; }
    .text { grid-column: 1; grid-row: 1; }
    .fig {
      top: 9svh;
      height: 70svh;
      padding: 0;
      border-bottom: 0;
      background: none;
    }

    section { padding: 4rem 0; }
    .hero, .close { min-height: 100svh; }
    .stage { min-height: 90svh; }
    .close { padding-bottom: 3.5rem; }

    .title-block {
      position: fixed;
      right: 28px;
      bottom: 28px;
      z-index: 5;
      display: grid;
      grid-template-columns: 1fr 1fr;
      width: 400px;
      margin: 0;
      background: var(--bg);
      border: 1.5px solid var(--fg);
    }
    .title-block div { padding: 9px 12px 10px; border: 0.75px solid var(--fg); }
    .title-block dt { font-size: 0.75rem; color: var(--muted); }
    .title-block dd { margin: 2px 0 0; font-size: 1.25rem; font-weight: 500; line-height: 1.2; font-variant-numeric: tabular-nums; }
  }
</style>
